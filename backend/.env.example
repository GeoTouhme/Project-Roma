# Example environment configuration for Project Roma backend.
# Copy this file to /etc/project-roma/.env on the server and fill in real values.
# NEVER commit real secrets to this repository.

# Server
PORT=5001

# MongoDB
# For local Docker Compose stack (default):
MONGODB_URI=mongodb://balport-mongo:27017/liquor_shop
# For MongoDB Atlas (optional):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/liquor_shop?retryWrites=true&w=majority&appName=APPNAME

# Email / Gmail OAuth2
EMAIL=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN

# Optional email receiver
RECEIVING_EMAIL=

# Optional flat shipping fee override
SHIPPING_FEE=

# Stripe
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
CURRENCY=usd

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS

# MFA encryption key (used to encrypt TOTP secrets at rest).
# Should be a long random string; defaults to JWT_SECRET if not set.
MFA_SECRET_KEY=CHANGE_THIS_TO_A_DIFFERENT_LONG_RANDOM_STRING

# CORS
ALLOWED_ORIGINS=https://balportliquors.com,https://www.balportliquors.com,https://admin.balportliquors.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_PUBLISHABLE_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET_KEY=your-cloudinary-api-secret

# DoorDash Drive
DOORDASH_DEVELOPER_ID=YOUR_DOORDASH_DEVELOPER_ID
DOORDASH_KEY_ID=YOUR_DOORDASH_KEY_ID
DOORDASH_SIGNING_SECRET=YOUR_DOORDASH_SIGNING_SECRET
DOORDASH_ENV=sandbox

# Uber Direct
UBER_DIRECT_CLIENT_ID=YOUR_UBER_CLIENT_ID
UBER_DIRECT_CLIENT_SECRET=YOUR_UBER_CLIENT_SECRET
UBER_DIRECT_CUSTOMER_ID=YOUR_UBER_CUSTOMER_ID
UBER_DIRECT_WEBHOOK_SECRET=YOUR_UBER_WEBHOOK_SECRET

# Customer storefront URL (used in email links)
FRONTEND_URL=https://balportliquors.com

# Customer panel build args (required at image build time)
REACT_APP_STRIPE_PUBLIC_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
REACT_APP_GOOGLE_MAPS_KEY=YOUR_GOOGLE_MAPS_API_KEY
